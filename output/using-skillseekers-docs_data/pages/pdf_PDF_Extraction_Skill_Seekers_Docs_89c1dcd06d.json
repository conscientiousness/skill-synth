  "code_samples": [
    {
      "code": "skill-seekers pdf [OPTIONS]",
      "language": "unknown"
    },
    {
      "code": "# Basic PDF extraction\nskill-seekers pdf --pdf docs/manual.pdf --name myskill\n\n# Scanned PDFs with OCR\nskill-seekers pdf --pdf docs/scanned.pdf --name myskill --ocr\n\n# Password-protected PDFs\nskill-seekers pdf --pdf docs/encrypted.pdf --name myskill --password mypassword\n\n# Advanced features\nskill-seekers pdf --pdf docs/manual.pdf --name myskill \\\n    --extract-tables \\\n    --parallel \\\n    --workers 8",
      "language": "markdown"
    },
    {
      "code": "# Install OCR dependencies\npip install pytesseract Pillow\n\n# Install Tesseract OCR engine\n# macOS\nbrew install tesseract\n\n# Linux\nsudo apt install tesseract-ocr\n\n# Windows\n# Download from: https://github.com/UB-Mannheim/tesseract/wiki",
      "language": "markdown"
    },
    {
      "code": "skill-seekers pdf --pdf scanned_manual.pdf --name myskill --ocr",
      "language": "unknown"
    },
    {
      "code": "# Use all CPU cores\nskill-seekers pdf --pdf large_manual.pdf --name myskill --parallel\n\n# Specify worker count\nskill-seekers pdf --pdf large_manual.pdf --name myskill --parallel --workers 16",
      "language": "markdown"
    },
    {
      "code": "skill-seekers pdf --pdf data_report.pdf --name myskill --extract-tables",
      "language": "unknown"
    },
    {
      "code": "output/\n└── {name}/\n    ├── SKILL.md              # Main content\n    ├── references/\n    │   ├── index.md\n    │   ├── extracted_text.md\n    │   ├── tables.md         # If --extract-tables\n    │   └── code_blocks.md\n    └── assets/\n        ├── image_001.png     # Extracted images\n        └── ...",
      "language": "unknown"
    },
    {
      "code": "skill-seekers pdf --pdf technical_manual.pdf --name technical \\\n    --description \"Technical manual from PDF\" \\\n    --ocr \\\n    --extract-tables \\\n    --parallel \\\n    --workers 8 \\\n    --output output/technical",
      "language": "sql"
    },
    {
      "code": "skill-seekers pdf --pdf encrypted.pdf --name secure \\\n    --password \"my-secure-password\" \\\n    --extract-tables",
      "language": "unknown"
    },
    {
      "code": "# Process multiple PDFs\nfor pdf in docs/*.pdf; do\n    name=$(basename \"$pdf\" .pdf)\n    skill-seekers pdf --pdf \"$pdf\" --name \"$name\" --parallel\ndone",
      "language": "bash"
    },
    {
      "code": "# Check Tesseract installation\ntesseract --version\n\n# If not found, install:\n# macOS: brew install tesseract\n# Linux: sudo apt install tesseract-ocr",
      "language": "markdown"
    },
    {
      "code": "skill-seekers pdf --pdf doc.pdf --name myskill --ocr --extract-tables",
      "language": "unknown"
    },
    {
      "code": "skill-seekers pdf --pdf huge.pdf --name myskill --parallel --workers 2",
      "language": "unknown"
    }
